<Window x:Class="Relatorio.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relatório - Visualização Interna" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <Button Content="🖨️ IMPRIMIR" 
                        Padding="15,5" 
                        Background="#007ACC" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        BorderThickness="0"
                        Click="Print_Click"/>
            </StackPanel>
        </Border>
        
        <WebBrowser Grid.Row="1" x:Name="ReportBrowser"/>
    </Grid>
</Window>
